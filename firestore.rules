rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'trilogypublishers2022@gmail.com';
    }

    // Stories/chapters can only be written by the single admin account.
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /chapters/{chapterId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Reader engagement can be extended here when the app's local engagement
    // layer is migrated to Firestore. Admin retains full control.
    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
